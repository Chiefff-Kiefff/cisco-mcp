# Copy to .env (gitignored) and fill in. Real environment variables override.

# Read-only account -- used for ALL normal tool calls.
CISCO_RO_USERNAME=ro_user
CISCO_RO_PASSWORD=changeme

# Privilege-15 account -- used ONLY for 'show running-config' on IOS/IOS-XE.
CISCO_PRIV15_USERNAME=priv15_user
CISCO_PRIV15_PASSWORD=changeme

# Optional enable secrets. Leave blank when the account logs in already at the
# right privilege level (the common case for a dedicated priv-15 account).
# CISCO_RO_ENABLE_SECRET=
# CISCO_PRIV15_ENABLE_SECRET=

# Optional: path to inventory file (defaults to ./devices.yaml)
# CISCO_MCP_INVENTORY=/path/to/devices.yaml
